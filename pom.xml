<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.usermanag</groupId>
    <artifactId>UserManagementAPI</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>UserManagementAPI</name>
    <description>Spring Boot REST API for User Management</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.0.0</version> <!-- Ensure this matches your desired Spring Boot version -->
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <properties>
        <java.version>17</java.version>

        <!-- Define a consistent version for JJWT -->
        <jjwt.version>0.12.5</jjwt.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- Version is inherited from spring-boot-starter-parent -->
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <!-- Version is inherited from spring-boot-starter-parent -->
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <!-- REMOVED explicit version: It must align with the parent's Spring Boot version (3.0.0) -->
        </dependency>
        <!-- Spring Boot Starter Validation is often implicitly included with web, but can be explicit -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <!-- This brings in hibernate-validator and jakarta.validation-api. Version inherited from parent. -->
        </dependency>

        <!-- Database Drivers -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <!-- Version is inherited from spring-boot-starter-parent -->
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
            <!-- Version is inherited from spring-boot-starter-parent -->
        </dependency>

        <!-- JWT Dependencies (JJWT) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version> <!-- Use the defined property for consistency -->
            <!-- Default scope is 'compile' which is suitable for API interfaces -->
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version> <!-- Use the defined property -->
            <scope>runtime</scope> <!-- This is correct for the implementation -->
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version> <!-- Use the defined property -->
            <scope>runtime</scope> <!-- This is correct for the Jackson integration -->
        </dependency>

        <!-- Lombok for boilerplate code reduction -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version> <!-- Keep explicit version as it's not managed by Spring Boot parent -->
            <scope>provided</scope>
        </dependency>

        <!-- Jackson Datatype for Java 8 Date/Time API -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <!-- Version is inherited from spring-boot-starter-parent -->
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <!-- Version is inherited from spring-boot-starter-parent -->
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
            <!-- Version is inherited from spring-boot-starter-parent -->
        </dependency>
        <!-- REMOVED explicit junit-jupiter version: spring-boot-starter-test manages JUnit 5 versions -->
        <!-- The specific JUnit 5 artifacts are pulled in transitively by spring-boot-starter-test -->

        <!-- REMOVED: org.springframework.security:spring-security-core is redundant as it's pulled by spring-boot-starter-security -->
        <!-- REMOVED: org.hibernate.validator:hibernate-validator and jakarta.validation:jakarta.validation-api are now covered by spring-boot-starter-validation -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
